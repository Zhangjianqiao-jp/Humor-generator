#!/bin/sh
# Short, read-only allocation diagnostic for the b-batch shared-GPU route.
# This never loads a model and is only an authorization/visibility probe.
#PJM -L rscgrp=b-batch
#PJM -L gpu=1
#PJM -L elapse=00:05:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
python - <<'PY'
import json
import os
import subprocess
import torch

keys = sorted(k for k in os.environ if k.startswith("PJM") or "CUDA" in k or "NVIDIA" in k)
report = {"env": {k: os.environ[k] for k in keys}}
try:
    report["cuda_device_count"] = torch.cuda.device_count()
    report["cuda_devices"] = [torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())]
except Exception as exc:
    report["cuda_error"] = repr(exc)
try:
    report["nvidia_smi_l"] = subprocess.run(
        ["nvidia-smi", "-L"], text=True, capture_output=True, check=False,
    ).stdout
except Exception as exc:
    report["nvidia_smi_error"] = repr(exc)
print(json.dumps(report, indent=2, sort_keys=True))
PY
