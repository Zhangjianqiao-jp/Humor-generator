#!/bin/sh
# A4 engineering smoke only: no scientific training and no caption generation.
# GENKAI requires the node-allocated b-batch form for a simplex full-GPU job;
# do not add gpu=1 or exec-policy=simplex to this request.
#PJM -L rscgrp=b-batch
#PJM -L node=1
#PJM -L elapse=00:20:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"

config=configs/pilot/cross_attention_semantic_phase_a4.yaml
output=results/engineering_smoke/cross_attention_semantic_phase_a4
mkdir -p "$output"

python scripts/run_formal_preflight.py --output "$output/preflight.json"
python scripts/check_cuda_resource.py
python scripts/real_trace_bridge_smoke.py \
  --config "$config" \
  --trace-index data/cache/planner_traces_homer_strict_v35/index.jsonl \
  --output "$output/report.json"
python scripts/validate_phase_a4_smoke.py \
  --config "$config" \
  --report "$output/report.json" \
  > "$output/validation_contract.json"
test -s "$output/validation_contract.json"
