#!/bin/sh
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=01:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export OMP_NUM_THREADS=1

config=configs/pilot/cross_attention_semantic_phase_a3.yaml
checkpoint=outputs/pilot/cross_attention_semantic_phase_a3/best_bridge.pt
output=outputs/outer_semantic_confirmation/a3_outer40

python scripts/run_formal_preflight.py \
  --output "outputs/preflight/outer_semantic_confirmation_$(date +%Y%m%d_%H%M%S).json"
python scripts/check_cuda_resource.py
python scripts/run_outer_semantic_confirmation.py \
  --config "$config" \
  --checkpoint "$checkpoint" \
  --output "$output" \
  --seeds 20260830 20260831 20260832
python scripts/validate_outer_semantic_confirmation.py \
  --output "$output" \
  --expected-clusters 40 \
  --expected-seeds 3 \
  > "$output/validation_contract.json"
test -s "$output/validation_contract.json"
