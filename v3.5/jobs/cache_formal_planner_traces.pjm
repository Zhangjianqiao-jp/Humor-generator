#!/bin/sh
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=08:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"
: "${TRACE_RETRY_ROUND:=0}"

python scripts/check_environment.py
python scripts/check_v35_isolation.py
python scripts/verify_frozen_artifacts.py
python scripts/verify_clustered_dataset.py
python scripts/cache_planner_traces.py \
  --splits train validation \
  --attempts 5 \
  --retry-round "$TRACE_RETRY_ROUND" \
  --output data/cache/planner_traces_homer_strict_v35
test -s data/cache/planner_traces_homer_strict_v35/index.jsonl
