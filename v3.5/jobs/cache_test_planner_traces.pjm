#!/bin/sh
# Create sealed Planner traces for the 97 internal-test and 24 official-unseen
# clusters.  This is inference only; it never changes bridge training data.
# c-batch + gpu=1 is the validated native full-GPU shared contract.  Do not
# combine this with node=1 or an explicit simplex flag, and do not use MIG.
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=08:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"

python scripts/run_formal_preflight.py \
  --output "outputs/preflight/cache_test_planner_traces_$(date +%Y%m%d_%H%M%S).json"
python scripts/verify_clustered_dataset.py
python scripts/prepare_test_trace_inputs.py \
  --output data/processed/latent_bridge_v35/test_trace_inputs.jsonl
python scripts/cache_planner_traces.py \
  --dataset data/processed/latent_bridge_v35 \
  --input-manifest data/processed/latent_bridge_v35/test_trace_inputs.jsonl \
  --splits internal_test official_hia_unseen_test \
  --attempts 5 --retry-round 0 --enable-validator-repair \
  --output data/cache/planner_traces_homer_strict_v35_test
python scripts/validate_test_trace_cache.py \
  --cache data/cache/planner_traces_homer_strict_v35_test \
  --input-manifest data/processed/latent_bridge_v35/test_trace_inputs.jsonl \
  --output outputs/preflight/test_planner_trace_validation.json
test -s outputs/preflight/test_planner_trace_validation.json
