#!/bin/sh
# Adapter-free Planner trace generation for the sealed public-release 362 route.
# b-batch + node=1 is the validated node-exclusive full-GPU contract on GENKAI;
# do not add gpu=1 or exec-policy=simplex, and do not use MIG.
#PJM -L rscgrp=b-batch
#PJM -L node=1
# 362 contests × 3 Planner stages; historical 121-trace runs completed in
# under three minutes after model load.  One hour is an intentional, measured
# bound rather than a large queue reservation.
#PJM -L elapse=01:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"

# This preflight is CPU-only and must pass before loading the 7B model.
python scripts/preflight_pretrained_homer_traces.py \
  --output "outputs/preflight/pretrained_homer_traces_$(date +%Y%m%d_%H%M%S).json"
python scripts/cache_pretrained_homer_traces.py \
  --dataset data/processed/homer_pretrained_7b_public_release_362 \
  --output data/cache/homer_pretrained_7b_planner_traces \
  --attempts 8 \
  --seed 20260906 \
  --temperature 1.0 \
  --top-p 1.0
python scripts/verify_pretrained_homer_traces.py \
  --dataset data/processed/homer_pretrained_7b_public_release_362 \
  --cache data/cache/homer_pretrained_7b_planner_traces \
  --output outputs/preflight/pretrained_homer_trace_validation.json
test -s data/cache/homer_pretrained_7b_planner_traces/index.jsonl
