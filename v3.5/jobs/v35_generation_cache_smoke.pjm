#!/bin/sh
#PJM -L rscgrp=b-batch
#PJM -L node=1
#PJM -L elapse=00:30:00
#PJM -j
#PJM -S
set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"
if [ "${CACHE_ONLY:-0}" = 1 ]; then
  set -- --cache-only
else
  set --
fi
python scripts/check_selected_plan_generation.py --precision "${PROBE_PRECISION:-nf4_bf16}" "$@" --output "${SMOKE_OUTPUT:?unique output directory required}"
