#!/bin/sh
# Sealed A5 outer semantic confirmation.  A5 must be a complete bridge run;
# this job does not overwrite A4 and does not generate captions.
# c-batch + gpu=1 is the validated native full-GPU shared contract.  Do not
# combine gpu=1 with node=1 or an explicit simplex flag, and do not use MIG.
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=06:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1

python scripts/run_formal_preflight.py \
  --output "outputs/preflight/outer_semantic_confirmation_a5_$(date +%Y%m%d_%H%M%S).json"
python scripts/check_cuda_resource.py
config=configs/pilot/cross_attention_semantic_phase_a5.yaml
checkpoint=outputs/pilot/cross_attention_semantic_phase_a5_lengthmatched/best_bridge.pt
trace_index=data/cache/planner_traces_homer_strict_v35_test/index.jsonl
trace_inputs=data/processed/latent_bridge_v35/test_trace_inputs.jsonl
output=outputs/outer_semantic_confirmation/a5_outer121

python scripts/validate_test_trace_cache.py \
  --cache data/cache/planner_traces_homer_strict_v35_test \
  --input-manifest "$trace_inputs" \
  --output outputs/preflight/test_planner_trace_validation_a5.json
test -s "$checkpoint"

# Two-cluster real evaluator smoke before the sealed 121-cluster run.
python scripts/run_outer_semantic_confirmation_a5.py \
  --config "$config" --checkpoint "$checkpoint" \
  --trace-index "$trace_index" --trace-input-manifest "$trace_inputs" \
  --output outputs/engineering_smoke/outer_semantic_confirmation_a5 \
  --seeds 20260901 --max-clusters 2
python scripts/validate_outer_semantic_confirmation_a5.py \
  --output outputs/engineering_smoke/outer_semantic_confirmation_a5 \
  --expected-clusters 2 --expected-seeds 1 \
  > outputs/engineering_smoke/outer_semantic_confirmation_a5/validation_contract.json

python scripts/run_outer_semantic_confirmation_a5.py \
  --config "$config" --checkpoint "$checkpoint" \
  --trace-index "$trace_index" --trace-input-manifest "$trace_inputs" \
  --output "$output" --seeds 20260901 20260902 20260903
python scripts/validate_outer_semantic_confirmation_a5.py \
  --output "$output" --expected-clusters 121 --expected-seeds 3 \
  > "$output/validation_contract.json"
test -s "$output/validation_contract.json"
