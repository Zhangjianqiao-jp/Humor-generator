#!/bin/sh
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=04:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
: "${BRIDGE_CONFIG:?submit with -x BRIDGE_CONFIG=...}"
: "${BRIDGE_OUTPUT:?submit with -x BRIDGE_OUTPUT=...}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
unset PYTORCH_CUDA_ALLOC_CONF
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"

python scripts/run_formal_preflight.py --output "$BRIDGE_OUTPUT/preflight.json"
python scripts/check_cuda_resource.py
python scripts/real_trace_bridge_smoke.py \
  --config "$BRIDGE_CONFIG" \
  --trace-index data/cache/planner_traces_homer_strict_v35/index.jsonl \
  --output "$BRIDGE_OUTPUT/resource_smoke.json"
test -s "$BRIDGE_OUTPUT/resource_smoke.json"
python scripts/train_bridge.py --config "$BRIDGE_CONFIG" --output "$BRIDGE_OUTPUT"
test -s "$BRIDGE_OUTPUT/complete.json"
