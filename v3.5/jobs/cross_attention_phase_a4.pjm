#!/bin/sh
# A4 is a bridge-only semantic pilot.  It uses one node/full native GPU and
# never unfreezes either 7B policy.  Caption generation is blocked unless the
# channel-isolated semantic gate passes.
#PJM -L rscgrp=b-batch
#PJM -L node=1
#PJM -L elapse=04:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"

config=configs/pilot/cross_attention_semantic_phase_a4.yaml
output=outputs/pilot/cross_attention_semantic_phase_a4

python scripts/run_formal_preflight.py --output "$output/preflight.json"
python scripts/check_cuda_resource.py
python scripts/real_trace_bridge_smoke.py \
  --config "$config" \
  --trace-index data/cache/planner_traces_homer_strict_v35/index.jsonl \
  --output "$output/resource_smoke.json"
python scripts/validate_phase_a4_smoke.py \
  --config "$config" \
  --report "$output/resource_smoke.json" \
  > "$output/resource_smoke_contract.json"
test -s "$output/resource_smoke_contract.json"

python scripts/train_bridge.py --config "$config" --output "$output"
test -s "$output/complete.json"
python scripts/check_semantic_training_gate.py \
  --config "$config" \
  --metrics "$output/metrics.jsonl" \
  --output "$output/semantic_gate.json" \
  --report-only
test -s "$output/semantic_gate.json"
status=$(python -c 'import json; print(json.load(open("outputs/pilot/cross_attention_semantic_phase_a4/semantic_gate.json"))["status"])')
case "$status" in
  strong_go|go_to_outer_semantic_validation) ;;
  *) echo "A4 semantic gate did not pass: $status" >&2; exit 2 ;;
esac
