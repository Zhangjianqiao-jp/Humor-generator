#!/bin/sh
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=04:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
unset PYTORCH_CUDA_ALLOC_CONF
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export OMP_NUM_THREADS=1
export NLTK_DATA="$PWD/artifacts/nltk_data"

python scripts/check_cuda_resource.py

out=outputs/pilot_validation
mkdir -p "$out"
common="--receiver sft --split validation --seeds 20260830 20260831 20260832 --exclude-clusters-file outputs/pilot/typed_sft_kl_visualcap_v2/run_manifest.json"

python scripts/generate_formal_baseline.py --condition text_homer --label text_homer \
  --config configs/pilot/learned_sft_kl.yaml --output "$out/text_homer.jsonl" $common
python scripts/generate_formal_baseline.py --condition statebridge --label statebridge \
  --config configs/pilot/learned_sft_kl.yaml --output "$out/statebridge.jsonl" $common
python scripts/generate_formal_baseline.py --condition full_plan_text --label full_plan_text \
  --config configs/pilot/learned_sft_kl.yaml --output "$out/full_plan_text.jsonl" $common
python scripts/generate_formal_baseline.py --condition budget_text --label budget_text \
  --config configs/pilot/learned_sft_kl.yaml --output "$out/budget_text.jsonl" $common
python scripts/generate_formal_baseline.py --condition token_embedding --label token_embedding \
  --config configs/pilot/learned_sft_kl.yaml --output "$out/token_embedding.jsonl" $common
python scripts/generate_formal_baseline.py --condition learned_latent --label learned_kl \
  --config configs/pilot/learned_sft_kl.yaml \
  --checkpoint outputs/pilot/learned_sft_kl_visualcap_v2/best_bridge.pt \
  --output "$out/learned_kl.jsonl" $common
python scripts/generate_formal_baseline.py --condition typed_learned_latent --label typed_kl \
  --config configs/pilot/typed_sft_kl.yaml \
  --checkpoint outputs/pilot/typed_sft_kl_visualcap_v2/best_bridge.pt \
  --output "$out/typed_kl.jsonl" $common
python scripts/generate_formal_baseline.py --condition typed_learned_latent --label typed_quantized \
  --config configs/pilot/typed_sft_kl.yaml \
  --checkpoint outputs/pilot/typed_sft_kl_visualcap_v2/best_bridge.pt --quantize-bridge-output \
  --allow-invalid-posthoc-quantization-diagnostic \
  --output "$out/typed_quantized.jsonl" $common
python scripts/generate_formal_baseline.py --condition typed_learned_latent --label typed_no_kl \
  --config configs/pilot/typed_sft_no_kl.yaml \
  --checkpoint outputs/pilot/typed_sft_no_kl_visualcap_v2/best_bridge.pt \
  --output "$out/typed_no_kl.jsonl" $common

python scripts/build_group_packets.py \
  --generations "$out/text_homer.jsonl" "$out/statebridge.jsonl" \
    "$out/full_plan_text.jsonl" "$out/budget_text.jsonl" \
    "$out/token_embedding.jsonl" "$out/learned_kl.jsonl" "$out/typed_kl.jsonl" \
    "$out/typed_quantized.jsonl" "$out/typed_no_kl.jsonl" \
  --packet "$out/blind_packet.jsonl" \
  --private-mapping "$out/private_mapping.jsonl" \
  --group-size 3 --family pilot_architecture --mirror-sides \
  --calibration data/cache/judge_calibration.json \
  --comparison text_homer:statebridge \
  --comparison text_homer:learned_kl \
  --comparison text_homer:typed_kl \
  --comparison statebridge:learned_kl \
  --comparison statebridge:typed_kl \
  --comparison token_embedding:learned_kl \
  --comparison token_embedding:typed_kl \
  --comparison typed_no_kl:typed_kl \
  --comparison full_plan_text:typed_kl \
  --comparison budget_text:typed_kl \
  --comparison typed_quantized:typed_kl

test -s "$out/blind_packet.jsonl"
test -s "$out/private_mapping.jsonl"
