#!/bin/sh
# A4 channel-isolated outer evaluator smoke.  Node allocation is the
# simplex/node-exclusive GPU mode on GENKAI; do not add gpu=1 or exec-policy.
#PJM -L rscgrp=b-batch
#PJM -L node=1
#PJM -L elapse=00:30:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv/bin/activate
export PYTHONPATH=src
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_ALLOC_CONF=backend:native
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1

python scripts/check_cuda_resource.py
config=configs/pilot/cross_attention_semantic_phase_a4.yaml
checkpoint=outputs/pilot/cross_attention_semantic_phase_a4_cbatch_retry1/best_bridge.pt
output=outputs/engineering_smoke/outer_semantic_confirmation_a4

python scripts/run_formal_preflight.py \
  --output "outputs/preflight/outer_semantic_confirmation_a4_smoke_$(date +%Y%m%d_%H%M%S).json"
python scripts/run_outer_semantic_confirmation_a4.py \
  --config "$config" \
  --checkpoint "$checkpoint" \
  --output "$output" \
  --seeds 20260830 \
  --max-clusters 2
python scripts/validate_outer_semantic_confirmation_a4.py \
  --output "$output" \
  --expected-clusters 2 \
  --expected-seeds 1 > "$output/validation_contract.json"
test -s "$output/validation_contract.json"
