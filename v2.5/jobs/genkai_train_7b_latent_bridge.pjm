#!/bin/sh
#PJM -L rscgrp=c-batch
#PJM -L gpu=1
#PJM -L elapse=05:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv-genkai/bin/activate
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=8

config=configs/latent_communication/bridge_sft.yaml

# The separate MIG smoke must have completed before this full-H100 job.
test -s outputs/latent_communication/bridge_sft_smoke/best.pt
test -s outputs/latent_communication/bridge_sft_smoke/run_manifest.json

# Full bridge-only training.  No Planner or Generator parameter is trainable.
python scripts/train_latent_bridge.py --config "$config"
