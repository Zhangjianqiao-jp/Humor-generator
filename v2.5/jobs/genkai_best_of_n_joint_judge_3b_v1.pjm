#!/bin/sh
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=02:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv-genkai/bin/activate
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

root=results/preference_diagnostics/best_of_n_joint_vs_direct_v1/joint
python scripts/preference_diagnostics/judge_humor_candidates_qwen.py \
  --config configs/preference_diagnostics_captioner_3b.yaml \
  --input-jsonl "$root/candidates.jsonl" --output-jsonl "$root/humor_judgments.jsonl" \
  --limit 24 --max-candidates 32 --candidate-batch-size 2 --max-new-tokens 256 --resume
python scripts/preference_diagnostics/best_of_n.py \
  --policy-scope joint --config configs/preference_diagnostics_captioner_3b.yaml \
  --adapter outputs/newyorker_compact_v2_captioner_3b_qlora/best_val_loss \
  --input-jsonl outputs/newyorker_caption_aware_v3_joint_vs_direct_eval/inputs_final.jsonl \
  --output-dir "$root" --score-jsonl "$root/humor_judgments.jsonl" \
  --score-field humor --good-threshold 4 --n-values 1,2,4,8,16,32 --seed 20260824
echo "[formal-diagnostic] joint Best-of-N scoring completed"
