#!/bin/sh
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=01:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv-genkai/bin/activate
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=8

python scripts/verify_lora_adapter.py outputs/newyorker_compact_v2_captioner_3b_qlora/best_val_loss
python scripts/preference_diagnostics/humor_representation_probe.py \
  --config configs/preference_diagnostics_captioner_3b.yaml \
  --adapter outputs/newyorker_compact_v2_captioner_3b_qlora/best_val_loss \
  --examples results/preference_diagnostics/humor_probe_v1/examples.jsonl \
  --output-dir results/preference_diagnostics/humor_probe_smoke_3b \
  --max-images 8 \
  --batch-size 1 \
  --epochs 50 \
  --seed 20260824

echo "[smoke] humor representation probe completed"
