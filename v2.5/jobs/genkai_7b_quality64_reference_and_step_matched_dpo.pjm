#!/bin/sh
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=07:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv-genkai/bin/activate
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=4

reference_config=configs/7b_generator/dpo_reference_quality64.yaml
dpo_config=configs/7b_generator/dpo_quality64_step_matched.yaml
reference_root=data/processed/newyorker_published_dpo_reference_7b_generator_quality64
pilot_train="$reference_root/dpo_train_step_matched_1264.jsonl"

python scripts/verify_lora_adapter.py outputs/7b-generator/best_val_loss

# A longest-text, batch-size-1 pressure smoke validates the stable MIG path.
python scripts/precompute_dpo_reference_logps.py \
  --config "$reference_config" \
  --splits train \
  --stress-longest-text \
  --output-dir "$reference_root/smoke_longest"
test "$(wc -l < "$reference_root/smoke_longest/dpo_train.jsonl")" -eq 1

# Compute the complete Quality64 training reference. The held-out test is sealed.
python scripts/precompute_dpo_reference_logps.py \
  --config "$reference_config" \
  --splits train \
  --resume
test "$(wc -l < "$reference_root/dpo_train.jsonl")" -eq 17297

python scripts/preference_diagnostics/select_step_matched_quality_pairs.py \
  --input "$reference_root/dpo_train.jsonl" \
  --output "$pilot_train" \
  --manifest "$reference_root/step_matched_1264_manifest.json" \
  --pairs 1264
test "$(wc -l < "$pilot_train")" -eq 1264

# Same 1,264 pairs / accumulation 8 / one epoch = exactly 158 updates.
python scripts/train_lora_dpo.py --config "$dpo_config"
python scripts/verify_lora_adapter.py \
  outputs/7b-generator-dpo/dpo_mlp_quality64_step_matched/final

test "$(python - <<'PY'
import json
from pathlib import Path
rows = [json.loads(line) for line in Path('outputs/7b-generator-dpo/dpo_mlp_quality64_step_matched/train_metrics.jsonl').read_text().splitlines()]
print(max(row.get('step', -1) for row in rows))
PY
)" -eq 158

python scripts/compare_dpo_validation_gate.py \
  --old outputs/7b-generator-dpo/dpo_mlp_fullpairs/train_metrics.jsonl \
  --new outputs/7b-generator-dpo/dpo_mlp_quality64_step_matched/train_metrics.jsonl \
  --output results/7b_generator/dpo_quality64_step_matched/validation_gate.json

echo "[quality64] full train reference + exactly 158-step DPO pilot passed"
