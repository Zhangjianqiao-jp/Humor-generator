#!/bin/sh
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=00:30:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv-genkai/bin/activate
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=8

python scripts/verify_lora_adapter.py \
  outputs/newyorker_compact_v2_captioner_3b_qlora/best_val_loss

python scripts/precompute_dpo_reference_logps.py \
  --config configs/dpo_reference_published_newyorker_compact_3b.yaml

python scripts/train_lora_dpo.py \
  --config configs/lora_dpo_published_newyorker_compact_3b.yaml \
  --debug-one-step

echo "[preference] published reference computation and one-step LoRA-DPO smoke passed"
