#!/bin/sh
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=02:00:00
#PJM -j
#PJM -S

set -eu
cd "${PJM_O_WORKDIR:-$(dirname "$0")/..}"
module purge
module load python/3.12.11
module load cuda/12.6.1
. .venv-genkai/bin/activate
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=8

config=configs/preference_diagnostics_captioner_3b.yaml
adapter=outputs/newyorker_compact_v2_captioner_3b_qlora/best_val_loss
pairs=results/preference_diagnostics/current_rank_pairs/pairs.jsonl
out=results/preference_diagnostics/captioner_3b_v1

python scripts/verify_lora_adapter.py "$adapter"

# One matched H2 pair from each of the 79 training images.
python scripts/preference_diagnostics/image_shuffle.py \
  --config "$config" \
  --adapter "$adapter" \
  --pairs "$pairs" \
  --max-samples 79 \
  --seed 20260824 \
  --output-dir "$out/image_shuffle"

# Thirty-two image-diverse pairs are sufficient for a first gradient map.
python scripts/preference_diagnostics/module_gradient_analysis.py \
  --config "$config" \
  --adapter "$adapter" \
  --pairs "$pairs" \
  --max-pairs 32 \
  --batch-size 1 \
  --output-dir "$out/module_gradients"

echo "[formal-diagnostic] captioner 3B v1 completed"
